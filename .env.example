# ─── Supabase ─────────────────────────────────────────────
# Obtén estos valores en: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# ─── Finnhub ──────────────────────────────────────────────
# Crea tu API key gratuita en: https://finnhub.io/register
# NUNCA expongas esta clave en el cliente. Solo se usa en API routes del servidor.
FINNHUB_API_KEY=your-finnhub-api-key-here

# ─── Resend ───────────────────────────────────────────────
# Crea tu API key gratuita en: https://resend.com (3,000 correos/mes gratis)
# Usada para enviar correos de alertas de precio/TRM.
RESEND_API_KEY=your-resend-api-key-here

# ─── Cron ─────────────────────────────────────────────────
# Valor secreto arbitrario propio (no proviene de ningún servicio externo).
# Protege el endpoint /api/cron/check-alerts: Vercel Cron lo manda como
# "Authorization: Bearer $CRON_SECRET" automáticamente si está configurado
# en las variables de entorno del proyecto en Vercel.
CRON_SECRET=your-random-secret-here
